# Copy to secrets.env (chmod 600). Never commit secrets.env.
# All values optional depending on profile. Empty = prompt or skip.

# Prefer SSH keys. If you must use a password helper, set only locally:
# SSH_PASS=
# Never put production sudo passwords in git.

# Apache / deploy (minimal-web)
# WEB_SSH_USER=
# WEB_SSH_HOST=

# Ollama / companion (ai-desk)
# OLLAMA_HOST=http://127.0.0.1:11434
# COMPANION_SECRET=   # generate your own random string

# Cloudflare (optional later — not required for LAN profiles)
# CF_API_TOKEN=
# CF_ACCOUNT_ID=

# Public tunnel hostnames (optional)
# ARIA_PUBLIC_HOST=
# DASH_PUBLIC_HOST=
